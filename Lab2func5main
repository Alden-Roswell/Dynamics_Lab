clear, close all, clc;

%function attitude313 = EulerAngles313(DCM)
%Goal: use the DCM to extract the 3-1-3 Euler angles
%Inputs: 9 values that are calculated according to 3-1-3 rotation sequences
%DCM: a rotation matrix
%Outputs: Euler angles for a 3-1-3 rotation sequence
% %attitude313: 3 x 1 vector with the 3-1-3 Euler angles in the form attitude313 = [roll, pitch, yaw]T

% first we need in input a general form of a 3-1-3 DCM rotation matrix

%set angles a, b, and y as an arbitaray number
alpha=1;
beta=7;
gamma=-5;

% input the trig expressions for each part of the matrix, calculated using
% the simple rotation matricies in the lab document
r11= cos(alpha)*cos(gamma)-sin(alpha)*sin(beta)*sin(gamma);
r12= cos(alpha)*sin(gamma)+sin(alpha)*cos(beta)*cos(gamma);
r13= sin(gamma)*sin(beta);
r21= -sin(alpha)*cos(gamma)-cos(alpha)*cos(beta)*sin(gamma);
r22= -sin(gamma)*sin(alpha)+cos(alpha)*sin(gamma)*cos(beta);
r23 = cos(alpha)*sin(beta);
r31= sin(beta)*cos(gamma);
r32= -sin(beta)*cos(gamma);
r33= cos(beta);

%set up the matrix that will be passed into the function to calculate the
%euler angles
DCM = [r11, r12, r13; r21, r22, r23; r31, r32, r33];

%the call and return of the euler angle vector from the function given the
%3-1-3 DCM
attitude313 = EulerAngles313(DCM);
